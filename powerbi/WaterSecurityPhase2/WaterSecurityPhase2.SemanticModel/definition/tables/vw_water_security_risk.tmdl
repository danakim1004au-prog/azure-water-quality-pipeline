table vw_water_security_risk
	lineageTag: 9c368d16-1314-432d-b767-1f5d7220db60

	measure 'Critical Bores' = CALCULATE ( COUNTROWS ( vw_water_security_risk ), vw_water_security_risk[risk_status] = "Critical" )
		formatString: 0
		lineageTag: 7a0883a5-da8b-475c-a0fb-c0d360ed1167

	measure 'Watch Bores' = CALCULATE ( COUNTROWS ( vw_water_security_risk ), vw_water_security_risk[risk_status] = "Watch" )
		formatString: 0
		lineageTag: 3b022541-eb1f-4497-986b-cda6f9b09e2f

	measure 'Average Risk Score' = AVERAGE ( vw_water_security_risk[risk_score] )
		formatString: 0.0
		lineageTag: 1b14b8e4-0993-4b5d-bef9-7dcca2bf4713

	measure 'Bores Projected Above Allocation' = CALCULATE ( DISTINCTCOUNT ( vw_water_security_risk[well_id] ), vw_water_security_risk[projected_allocation_pct] > 100 )
		formatString: 0
		lineageTag: 1d3f6764-8458-468a-a759-e49ec48f2288

	measure 'Average 60-day Level Change' = AVERAGE ( vw_water_security_risk[forecast_change_mbgl] )
		formatString: 0.00" m"
		lineageTag: d5955194-5e44-4a1e-a45d-4dd34247ece0

	measure 'Risk Status Colour' = SWITCH ( SELECTEDVALUE ( vw_water_security_risk[risk_status] ), "Critical", "#D64550", "Watch", "#B98600", "Normal", "#107C10", "#605E5C" )
		lineageTag: 90fd8a14-8ce5-4c78-a246-cc8529e2f489

	measure 'Risk Bar Colour' = SWITCH ( SELECTEDVALUE ( vw_water_security_risk[risk_status] ), "Critical", "#D64550", "Watch", "#E8A33D", "Normal", "#107C10", "#605E5C" )
		lineageTag: 92e9daaa-7fe0-459e-baca-97d1f808deae

	measure 'Highest Projected Allocation Use' = MAX ( vw_water_security_risk[projected_allocation_pct] )
		formatString: 0.0
		lineageTag: 33333333-aaaa-4bbb-8ccc-333333333333

	measure 'Average 30-day Data Completeness' = AVERAGE ( vw_water_security_risk[data_completeness_30d_pct] )
		formatString: 0.0
		lineageTag: 44444444-aaaa-4bbb-8ccc-444444444444

	measure 'Selected Recommended Action' = SELECTEDVALUE ( vw_water_security_risk[recommended_action], "Select one bore to review the recommended action." )
		lineageTag: 55555555-aaaa-4bbb-8ccc-555555555555

