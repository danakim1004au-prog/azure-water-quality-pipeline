# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.pytest_cache/

# Terraform
infra/.terraform/
infra/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# Azure Functions
functions/local.settings.json
functions/bin/
functions/obj/
.python_packages/

# Data / secrets
data/raw/
data/processed/
*.csv
!sample_data/*.csv
secrets.json

# ML artefacts: regenerable model binaries and large scored outputs stay out of
# git; the small result summaries and the example chart are kept so reviewers
# can see the numbers without running training.
ml/artifacts/*.joblib
!ml/artifacts/forecast_horizon_sweep.csv

# Power BI temp
*.pbix.tmp
~$*.pbix

# Local-only HTML mockup used to regenerate dashboard screenshots
# (not part of the published project; the real deliverable is the .pbix)
powerbi/mockup/

# OS / IDE
.DS_Store
.vscode/
.idea/
